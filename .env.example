OPENROUTER_API_KEY="your-api-key"
NOVA_DB_URL=postgresql://nova:nova_dev@localhost/nova_db
SERPER_API_KEY="your-serper-api-key"

# [⚠️ WIP]: pVAD — Personalized VAD (speaker-conditioned gate, fail-open by default)
NOVA_PVAD_ENABLED=0            # set to 1 once a voiceprint is enrolled via L-3/enroll.py
NOVA_PVAD_BARGEIN_ENABLED=0   # 1 = driver voice mid-TTS interrupts Nova; 0 = TTS plays through
# NOVA_PVAD_DRIVER_ID=driver1  # voiceprint ID under nova-l7/L-3/data/voiceprints/
# NOVA_PVAD_THRESHOLD=0.58     # cosine similarity cutoff (lower = more permissive)
# NOVA_PVAD_HYSTERESIS=2       # consecutive windows required before gate state changes
# NOVA_PVAD_ENERGY=0.035       # RMS energy floor; below this = silence, gate stays open

# LLM mode (default: auto — query router picks local vs cloud per query)
NOVA_LLM_MODE=cloud           # cloud-only: skip local model load entirely (use on Jetson/aarch64)
# NOVA_LLM_MODE=local           # local-only: never call OpenRouter
# NOVA_LLM_MODE=auto            # auto: router decides per query

# Controls the intent classification
# Options: tool_calling | regex
NOVA_DM_MODE=regex         # LLM handling phrasing variance stronger than regex + embedding thresholds

# STT backend selection
# NOVA_STT_VARIANT=small                    # default Moonshine small streaming
NOVA_STT_VARIANT=qwen3_asr_0_6b             # Qwen3-ASR-0.6B
# NOVA_STT_VARIANT=kyutai_stt_1b_en_fr      # Kyutai STT 1B with built-in semantic VAD
# NOVA_STT_VARIANT=kyutai_stt_2_6b_en       # Kyutai STT 2.6B (no VAD heads)

# Kyutai STT tuning (only applies when a kyutai_* variant is active)
NOVA_KYUTAI_DEVICE=cuda          # cuda | cpu
NOVA_KYUTAI_EMA_THRESH=0.8       # end-of-turn fires when EMA(prs[head]) > this (lower = snappier)
NOVA_KYUTAI_HEAD_IDX=2           # 0=0.5s pause, 1=1s, 2=2s (Unmute default), 3=3s
NOVA_KYUTAI_PREEMPH=0            # 1 = apply 0.97 pre-emphasis before encode; 0 = raw audio (recommended for Kyutai)
NOVA_KYUTAI_RMS_NORM=0           # 1 = normalize chunk RMS to 0.08; 0 = leave gain untouched

# Smart-Turn v3 semantic end-of-turn classifier (pipecat-ai/smart-turn-v3)
# Gates utterance finalize on "is the speaker really done?" — lets users
# pause mid-thought without getting cut off. Wired into all three STT backends:
#   - Qwen3-ASR: gates the end_silence_s trip in the VAD idle branch.
#   - Kyutai:    confirms EMA-head end-of-turn (semantic + acoustic stack).
#   - Moonshine: buffers held lines on_line_completed, concatenates on release.
# Fail-open: smart-turn load/inference errors revert to silence-only behavior.
NOVA_SMART_TURN=1                 # 1 = enable (default 0 — off for safety)
NOVA_SMART_TURN_THRESHOLD=0.5     # finalize when prob >= this (raise for stricter)
NOVA_SMART_TURN_MAX_WAIT_MS=3000  # hard cap on hesitation hold (prevents stall)
NOVA_QWEN3_END_SILENCE_MS=1500    # raise end-silence with smart-turn on (was 800)

# Mic front-end — WebRTC APM (AEC3 + NS + AGC + HPF) + Silero VAD speech events
# Always-on when enabled (Phase 1): every mic chunk runs through APM, the
# cleaned signal feeds STT, and Silero hysteresis emits speech_start /
# speech_end events. In NO_KWS mode the gateway uses speech_end to finalize
# STT (deterministic VAD turn boundary, no per-worker NO_SPEECH_TIMEOUT
# thrash). In all modes a speech_start during TTS playback (past guard window)
# is treated as a barge-in. Fail-open: load error silently disables.
NOVA_FRONTEND_ENABLED=1             # 1 = enable APM + VAD front-end
NOVA_FRONTEND_VAD_THRESHOLD=0.5     # Silero prob above which a frame counts as voice
NOVA_FRONTEND_START_FRAMES=3        # consecutive voice frames → speech_start
NOVA_FRONTEND_END_FRAMES=24         # consecutive silence frames → speech_end (~770 ms)
NOVA_FRONTEND_REF_BUFFER_MS=500     # TTS reference ring buffer size (ms)
NOVA_AEC_GUARD_SEC=0.5              # skip first N sec of TTS for barge-in (AEC convergence)
# Legacy AEC vars are still honored for one release; prefer NOVA_FRONTEND_* above.
# NOVA_AEC_ENABLED, NOVA_AEC_VAD_THRESHOLD, NOVA_AEC_CONSECUTIVE_FRAMES,
# NOVA_AEC_REF_BUFFER_MS map onto the new vars at startup.

# Conversation session — WARM window between turns
# After Nova finishes speaking, STT auto-listens without requiring the wake
# word. The window closes (WARM → COLD) after either N consecutive STT
# no-speech timeouts OR a hard idle cap, whichever trips first. On close,
# DM history/intent-queue/pronoun-context are cleared and the user must say
# "Nova" again. UI surfaces the state via the SESSION pill and a chime.
NOVA_CONVERSATION_MAX_NO_SPEECH=2     # consecutive NO_SPEECH_TIMEOUT fires before closing
NOVA_CONVERSATION_IDLE_TIMEOUT_S=45   # hard idle cap since last user speech

# TTS engine selection — kokoro is fastest TTFT (~80 ms on GPU)
# Options: kokoro | pocket-tts | faster-qwen3
NOVA_TTS_ENGINE=pocket-tts

# Local Inference on Edge device (Jetson Thor)
NOVA_LLM_BACKEND=local
NOVA_LLM_BASE_URL=http://localhost:8080/v1
NOVA_LLM_MODEL=unsloth/gemma-4-E4B-it

NOVA_STT_BACKEND=qwen3_streaming   # rolling-buffer streaming (default) | qwen3_0_6b | kyutai_1b | moonshine | qwen3_trt

# gateway_simple latency tuning (Qwen3-ASR rolling-buffer streaming)
NOVA_QWEN3_PARTIAL_INTERVAL_MS=400    # cadence for in-flight partial transcribes
NOVA_QWEN3_PARTIAL_WINDOW_S=3.0       # rolling-window length fed to each partial
NOVA_QWEN3_STABILITY_TICKS=2          # consecutive identical partials → settled
NOVA_QWEN3_MAX_UTTERANCE_S=12.0       # hard cap before forced final

# Silence + min-speech floor (gateway_simple)
NOVA_SILENCE_END_MS=400               # was 700; tighter now that STT runs during speech
NOVA_MIN_SPEECH_MS=500                # don't finalize if utterance is shorter than this

# TTS network frame size (gateway_simple play_consumer)
NOVA_TTS_PLAY_CHUNK=2048              # samples @ 24 kHz → ~85 ms per WS frame (was 4096/170 ms)
# NOVA_TRT_EDGE_ROOT=/home/acf-thor/repos/TensorRT-Edge-LLM
# NOVA_TRT_ENGINE_DIR=/home/acf-thor/tensorrt-edgellm-workspace/Qwen3-ASR-0.6B/engines
# NOVA_TRT_TOKENIZER_DIR=/home/acf-thor/tensorrt-edgellm-workspace/Qwen3-ASR-0.6B/engines/llm

# ── DriveAuth Edge (pipeline_mp/driveauth) ───────────────────────────────────
# Trust/Risk separation + OTP step-up. Behaviour/GPS drive Risk, never Trust.
NOVA_RISK_APPROVE=0.35              # risk ≤ this = low-risk band
NOVA_RISK_REJECT=0.80              # risk ≥ this = hard-reject ceiling
NOVA_OTP_PROVIDER_URL=             # payment-provider send-OTP endpoint (cellular); empty → offline fallback
NOVA_FRAUD_LADDER_DECAY_HOURS=24   # how long a soft fraud flag persists before decay
NOVA_FINGERPRINT_AVAILABLE=1       # 0 on trims without an in-cabin fingerprint sensor (§3.3)
# NOVA_DRIVER_MOBILE=              # fallback registered number if none in store/contacts
