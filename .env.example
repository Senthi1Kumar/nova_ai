OPENROUTER_API_KEY="your-api-key"
NOVA_DB_URL=postgresql://nova:nova_dev@localhost/nova_db
SERPER_API_KEY="your-serper-api-key"

# [⚠️ WIP]: pVAD — Personalized VAD (speaker-conditioned gate, fail-open by default)
NOVA_PVAD_ENABLED=0            # set to 1 once a voiceprint is enrolled via L-3/enroll.py
# NOVA_PVAD_DRIVER_ID=driver1  # voiceprint ID under nova-l7/L-3/data/voiceprints/
# NOVA_PVAD_THRESHOLD=0.58     # cosine similarity cutoff (lower = more permissive)
# NOVA_PVAD_HYSTERESIS=2       # consecutive windows required before gate state changes
# NOVA_PVAD_ENERGY=0.035       # RMS energy floor; below this = silence, gate stays open

# LLM mode (default: auto — query router picks local vs cloud per query)
NOVA_LLM_MODE=cloud           # cloud-only: skip local model load entirely (use on Jetson/aarch64)
# NOVA_LLM_MODE=local           # local-only: never call OpenRouter
# NOVA_LLM_MODE=auto            # auto: router decides per query
