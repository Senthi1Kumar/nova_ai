# LiteRT-LM model
LITERT_MODEL_PATH=/absolute/path/to/your/model.litertlm
LITERT_BACKEND=GPU
LITERT_AUDIO_BACKEND=CPU
LITERT_VISION_BACKEND=GPU
LITERT_CACHE_DIR=
LITERT_SYSTEM_PROMPT=You are a helpful local AI assistant running with LiteRT-LM.
LITERT_ENABLE_SPECULATIVE=true
AUDIO_PROMPT_HINT=Respond conversationally to what the user just said.

# Pocket TTS text-to-speech
TTS_ENABLED=true
POCKET_TTS_VOICE=alba
POCKET_TTS_LANGUAGE=english
TTS_OUTPUT_DIR=runtime/tts

# Clause splitter (controls how often LLM tokens get flushed to TTS)
CLAUSE_MIN_CHARS=8
CLAUSE_COMMA_MIN_CHARS=32

# Tavily web search (optional — leave blank to disable the web_search tool)
TAVILY_API_KEY=

# Web server
APP_HOST=0.0.0.0
APP_PORT=8000
