# LiteRT-LM model
LITERT_MODEL_PATH=/absolute/path/to/your/model.litertlm
LITERT_BACKEND=GPU
LITERT_AUDIO_BACKEND=CPU
LITERT_VISION_BACKEND=CPU         # keep on CPU on ≤ 4 GB GPUs (avoids vision OOM); GPU only if ≥ 8 GB
LITERT_CACHE_DIR=
# Leave LITERT_SYSTEM_PROMPT unset to use the built-in Nova persona (driver-style,
# tool-aware, TTS-friendly). Set it here to override per-deployment. Single line only.
# LITERT_SYSTEM_PROMPT=
LITERT_ENABLE_SPECULATIVE=true
# Engine token budget. KV cache scales linearly with this value, so on a 4 GB
# GPU keep it ≤ 4096 (~6-8 tool-using turns of headroom). 8192 needs ~6 GB
# VRAM, 16384 needs ~8 GB. Too-low values (~2048, the model default) cause
# silent decode failures after a few tool turns — pick the largest you can
# afford. Falls back to model default if unset.
LITERT_MAX_NUM_TOKENS=4096
AUDIO_PROMPT_HINT=Respond conversationally to what the user just said.

# Pocket TTS text-to-speech
TTS_ENABLED=true
POCKET_TTS_VOICE=alba
POCKET_TTS_LANGUAGE=english
TTS_OUTPUT_DIR=runtime/tts

# Clause splitter (controls how often LLM tokens get flushed to TTS)
CLAUSE_MIN_CHARS=8
CLAUSE_COMMA_MIN_CHARS=32

# IResearcher FastMCP sidecar — start with `python -m app.tools_v2` in a
# second terminal. The chat app connects to this URL at startup.
IRESEARCHER_MCP_URL=http://127.0.0.1:8765/mcp

# Search-provider API keys are read by the SIDECAR (not the chat app).
# Export in your shell or put in a separate .env that the sidecar loads.
BRAVE_API_KEY=                   # https://api.search.brave.com — used by web_search
SERPER_API_KEY=                  # https://serper.dev — used by google_search

# Optional: only needed if you re-enable the dormant tavily_* helpers.
TAVILY_API_KEY=

# Web server
APP_HOST=0.0.0.0
APP_PORT=8000
